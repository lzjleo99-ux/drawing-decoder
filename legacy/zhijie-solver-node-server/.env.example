# 必填：Claude API 密钥
ANTHROPIC_API_KEY=sk-ant-...

# 可选：求解投入程度。low / medium / high / xhigh / max，默认 high。
# 理工科解题属于正确性敏感任务；对难题可提到 xhigh 或 max，代价是更慢更贵。
SOLVER_EFFORT=high

# 可选：同时求解的题目数，默认 3。触发速率限制时调小。
SOLVER_CONCURRENCY=3

# 可选：空跑模式。设为 1 时跳过模型调用，用抽取结果直接出文档，
# 用于在没有密钥的情况下自检"上传→抽取→排版→导出"整条链路。
# SOLVER_DRY_RUN=1

# 可选：服务端口，默认 3000
PORT=3000

# 可选：浏览器可执行文件路径。默认自动查找 Chrome / Chromium / Edge / Brave。
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
